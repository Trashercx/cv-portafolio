# Entorno de ejecución ("production" en el contenedor desplegado; controla,
# entre otras cosas, la bandera `secure` de la cookie de sesión en
# apps/api/src/modules/auth/auth.controller.ts — debe ser "production" en
# cualquier despliegue servido por HTTPS).
NODE_ENV="development"

# Puerto donde escucha Nest (apps/api/src/main.ts). 3000 en desarrollo; el
# proxy/reverse-proxy de Dokploy/Coolify en producción decide el puerto público.
PORT=3000

# Base de datos (coincide con docker-compose.yml para desarrollo local)
DATABASE_URL="postgresql://cvportafolio:cvportafolio@localhost:5433/cvportafolio?schema=public"

# Origen exacto del frontend, para CORS con credenciales (apps/api/src/main.ts).
# En desarrollo por defecto es http://localhost:5173 si no se define esta variable.
# En producción: la URL pública real de apps/web (https://...), sin barra final.
FRONTEND_ORIGIN="http://localhost:5173"

# Fase 6 — Fundamentos de producción (apps/api)
# Nivel de log de pino (fatal|error|warn|info|debug|trace|silent). Default: info.
# En producción la salida es JSON; fuera de producción se usa pino-pretty.
LOG_LEVEL="info"
# Rate limiting global por IP: ventana en ms y máximo de requests. Defaults: 60000 / 120.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Límite estricto de POST /auth/login (por IP). Defaults: 5 intentos / 60000 ms.
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000
# "true" cuando la API corre detrás de un proxy (Traefik/Dokploy/Coolify): confía en
# X-Forwarded-For (trust proxy = 1) para que el rate limit use la IP real del cliente.
# Déjalo en false/vacío si la API se expone directamente (un cliente podría falsear la IP).
TRUST_PROXY="false"

# Autenticación
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="15m"

# Administrador único (usado por apps/api/prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_SEED="cambia-esta-contrasena-antes-de-correr-el-seed"

# AWS S3 (multimedia)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""

# CloudFront (opcional, no requerido en v1)
CLOUDFRONT_DOMAIN=""

# Solo mientras media use el stub local (LocalMediaStorageService, Sprint 1) en vez de S3
PUBLIC_BASE_URL="http://localhost:3000"

# Frontend
# Vite la incrusta en el JS en tiempo de build, no de runtime. En desarrollo
# la lee de apps/web/.env.local; en la imagen Docker de apps/web hay que
# pasarla como --build-arg VITE_API_URL=<url pública real de apps/api>
# (ver apps/web/Dockerfile) — no basta con setearla como variable de
# entorno del contenedor en runtime, porque para entonces ya quedó fija en
# los archivos estáticos generados.
VITE_API_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Fase 8 — Visibilidad (UC-27, UC-34). TODAS opcionales: sin ellas el sitio
# funciona igual que antes (sin analítica y con los defaults de nginx).
# Detalle en docs/despliegue.md §7.
# ---------------------------------------------------------------------------

# [web, runtime de nginx] URL interna del API (esquema + host + puerto, sin
# barra final) a la que nginx hace proxy para inyectar los metadatos SEO por
# SSI en index.html y servir /sitemap.xml y /robots.txt. Default: el servicio
# `api` de docker-compose.prod.yml. Opcional.
SEO_UPSTREAM="http://api:3000"

# [web, runtime de nginx] Origen público de Umami para la CSP (script-src y
# connect-src). Vacío = sin analítica (la CSP no cambia). Debe coincidir con
# VITE_UMAMI_URL. Opcional.
ANALITICA_ORIGIN=""

# [web, BUILD ARG] Origen del tracker de Umami (sin barra final) e id del
# sitio creado en Umami. Si falta cualquiera de los dos no se inyecta ningún
# script en el sitio público. Como VITE_API_URL, quedan incrustados en el JS:
# cambiarlos exige reconstruir la imagen web. Opcional.
VITE_UMAMI_URL=""
VITE_UMAMI_WEBSITE_ID=""

# [api, runtime] Métricas de Umami en el panel (GET /admin/metricas). Sin
# UMAMI_API_URL o UMAMI_WEBSITE_ID el endpoint responde
# { disponible: false, motivo: 'no_configurado' }. Opcional.
# URL de Umami sin barra final (la pública, https://analitica.<dominio>, es
# la opción simple; o la interna http://umami:3000 si se unen las redes).
UMAMI_API_URL=""
# Mismo id que VITE_UMAMI_WEBSITE_ID.
UMAMI_WEBSITE_ID=""
# Autenticación contra la API de Umami: un token de API (Authorization:
# Bearer) O BIEN usuario + contraseña (POST /api/auth/login, token cacheado
# en memoria). Con las dos cosas definidas gana el token.
UMAMI_API_TOKEN=""
UMAMI_USUARIO=""
UMAMI_CONTRASENA=""

# [stack docker-compose.umami.yml] Solo si se despliega Umami autoalojado.
# Las dos primeras son OBLIGATORIAS para ese stack (generar con
# `openssl rand -hex 32`); el resto tiene default. No las usa ni api ni web.
UMAMI_DB_PASSWORD=""
UMAMI_APP_SECRET=""
UMAMI_DB_USER="umami"
UMAMI_DB_NAME="umami"
# Puerto de loopback del VPS donde se publica Umami para depurar (Traefik
# usa el puerto interno 3000 vía `expose`, no este).
UMAMI_PUBLIC_PORT=3100

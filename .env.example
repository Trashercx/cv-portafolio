# Base de datos (coincide con docker-compose.yml para desarrollo local)
DATABASE_URL="postgresql://cvportafolio:cvportafolio@localhost:5433/cvportafolio?schema=public"

# Autenticación
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="15m"

# Administrador único (usado por apps/api/prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_SEED="cambia-esta-contrasena-antes-de-correr-el-seed"

# AWS S3 (multimedia)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""

# CloudFront (opcional, no requerido en v1)
CLOUDFRONT_DOMAIN=""

# Solo mientras media use el stub local (LocalMediaStorageService, Sprint 1) en vez de S3
PUBLIC_BASE_URL="http://localhost:3000"

# Frontend
VITE_API_URL="http://localhost:3000"

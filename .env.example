# Entorno de ejecución ("production" en el contenedor desplegado; controla,
# entre otras cosas, la bandera `secure` de la cookie de sesión en
# apps/api/src/modules/auth/auth.controller.ts — debe ser "production" en
# cualquier despliegue servido por HTTPS).
NODE_ENV="development"

# Puerto donde escucha Nest (apps/api/src/main.ts). 3000 en desarrollo; el
# proxy/reverse-proxy de Dokploy/Coolify en producción decide el puerto público.
PORT=3000

# Base de datos (coincide con docker-compose.yml para desarrollo local)
DATABASE_URL="postgresql://cvportafolio:cvportafolio@localhost:5433/cvportafolio?schema=public"

# Origen exacto del frontend, para CORS con credenciales (apps/api/src/main.ts).
# En desarrollo por defecto es http://localhost:5173 si no se define esta variable.
# En producción: la URL pública real de apps/web (https://...), sin barra final.
FRONTEND_ORIGIN="http://localhost:5173"

# Fase 6 — Fundamentos de producción (apps/api)
# Nivel de log de pino (fatal|error|warn|info|debug|trace|silent). Default: info.
# En producción la salida es JSON; fuera de producción se usa pino-pretty.
LOG_LEVEL="info"
# Rate limiting global por IP: ventana en ms y máximo de requests. Defaults: 60000 / 120.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Límite estricto de POST /auth/login (por IP). Defaults: 5 intentos / 60000 ms.
THROTTLE_LOGIN_LIMIT=5
THROTTLE_LOGIN_TTL_MS=60000
# "true" cuando la API corre detrás de un proxy (Traefik/Dokploy/Coolify): confía en
# X-Forwarded-For (trust proxy = 1) para que el rate limit use la IP real del cliente.
# Déjalo en false/vacío si la API se expone directamente (un cliente podría falsear la IP).
TRUST_PROXY="false"

# Autenticación
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="15m"

# Administrador único (usado por apps/api/prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_SEED="cambia-esta-contrasena-antes-de-correr-el-seed"

# AWS S3 (multimedia)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
S3_BUCKET_NAME=""

# CloudFront (opcional, no requerido en v1)
CLOUDFRONT_DOMAIN=""

# Solo mientras media use el stub local (LocalMediaStorageService, Sprint 1) en vez de S3
PUBLIC_BASE_URL="http://localhost:3000"

# Frontend
# Vite la incrusta en el JS en tiempo de build, no de runtime. En desarrollo
# la lee de apps/web/.env.local; en la imagen Docker de apps/web hay que
# pasarla como --build-arg VITE_API_URL=<url pública real de apps/api>
# (ver apps/web/Dockerfile) — no basta con setearla como variable de
# entorno del contenedor en runtime, porque para entonces ya quedó fija en
# los archivos estáticos generados.
VITE_API_URL="http://localhost:3000"

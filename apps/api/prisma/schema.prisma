// Esquema de datos del portafolio/CV.
//
// Única fuente de verdad: docs/plan-portafolio.md, sección "Modelo de datos y diagrama ER"
// (bloque ```mermaid```). No agregues entidades/columnas/relaciones aquí sin que primero
// existan en ese documento. Nombres de tabla y columna en español y snake_case, igual que
// en el diagrama ER (@@map/nombre de campo reproducen el nombre exacto de la tabla/columna).
//
// USUARIO_ADMIN.intentos_fallidos / bloqueado_hasta: agregadas en el plan para cumplir el
// criterio de aceptación de UC-01 (bloqueo tras 3 intentos fallidos de login), ver Sprint 0.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // La URL de conexión vive en prisma7.config.ts (Prisma 7 movió `url` fuera de schema.prisma).
}

/// Administrador único del panel (preparado para más de un admin en el futuro vía `rol`).
model UsuarioAdmin {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique
  password_hash     String
  nombre            String
  rol               String    @default("admin")
  intentos_fallidos Int       @default(0)
  bloqueado_hasta   DateTime?
  created_at        DateTime  @default(now())

  perfil          Perfil?
  medias          Media[]
  /// Fase 7e, UC-09
  carpetas_media  CarpetaMedia[]
  proyectos       Proyecto[]
  certificaciones Certificacion[]
  /// Fase 7d, UC-35
  insignias       Insignia[]
  /// Fase 7l, UC-19
  experiencias    ExperienciaLaboral[]
  /// Fase 7l, UC-36
  integracion_github IntegracionGithub?
  logros          Logro[]
  redes_sociales  RedSocial[]
  secciones       Seccion[]
  temas           Tema[]
  skills          Skill[]
  fondos_sitio    FondoSitio[]
  versiones_sitio VersionSitio[]

  @@map("usuario_admin")
}

/// Datos de la sección "Sobre mí" (UC-02). Uno por administrador.
model Perfil {
  id                 String   @id @default(uuid()) @db.Uuid
  usuario_admin_id   String   @unique @db.Uuid
  nombre_completo    String
  titulo_profesional String
  resumen_bio        String   @db.Text
  imagen_perfil_id   String?  @db.Uuid
  cv_media_id        String?  @db.Uuid
  ubicacion          String
  updated_at         DateTime @updatedAt

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])
  imagen_perfil Media?       @relation("PerfilImagenPerfil", fields: [imagen_perfil_id], references: [id])
  cv_media      Media?       @relation("PerfilCvMedia", fields: [cv_media_id], references: [id])

  @@map("perfil")
}

/// Biblioteca multimedia (UC-09): catálogo de archivos subidos a S3, reutilizable
/// desde perfil, certificaciones y galería de proyectos.
model Media {
  id               String   @id @default(uuid()) @db.Uuid
  usuario_admin_id String   @db.Uuid
  /// Fase 7e, UC-09: carpeta opcional; al borrarla el archivo queda sin carpeta
  carpeta_id       String?  @db.Uuid
  url              String
  s3_key           String
  tipo             String
  ancho            Int?
  alto             Int?
  alt_text         String?
  created_at       DateTime @default(now())

  usuario_admin     UsuarioAdmin     @relation(fields: [usuario_admin_id], references: [id])
  carpeta           CarpetaMedia?    @relation(fields: [carpeta_id], references: [id], onDelete: SetNull)
  perfiles_imagen   Perfil[]         @relation("PerfilImagenPerfil")
  perfiles_cv       Perfil[]         @relation("PerfilCvMedia")
  certificaciones   Certificacion[]  @relation("CertificacionLogo")
  proyecto_imagenes ProyectoImagen[]
  variantes         MediaVariante[]
  /// Fase 7d, UC-35
  insignias         Insignia[]       @relation("InsigniaImagen")
  /// Fase 7l, UC-19
  experiencias      ExperienciaLaboral[] @relation("ExperienciaLogo")

  @@map("media")
}

/// Carpetas planas de la biblioteca multimedia (Fase 7e, UC-09). No altera la clave
/// de S3. La unicidad por (usuario_admin_id, lower(nombre)) la impone un índice
/// funcional editado a mano en la migración (carpeta_media_admin_nombre_unico), mismo
/// patrón que skill_admin_nombre_unico.
model CarpetaMedia {
  id               String   @id @default(uuid()) @db.Uuid
  usuario_admin_id String   @db.Uuid
  nombre           String
  orden            Int
  created_at       DateTime @default(now())

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])
  medias        Media[]

  @@index([usuario_admin_id, orden])
  @@map("carpeta_media")
}

/// Variantes responsive derivadas de un Media (Fase 8, UC-34): una fila por
/// formato y ancho. Se borran en cascada con su Media.
model MediaVariante {
  id         String   @id @default(uuid()) @db.Uuid
  media_id   String   @db.Uuid
  /// "webp" | "avif" ("jpeg" reservado)
  formato    String
  ancho      Int
  alto       Int
  url        String
  s3_key     String
  bytes      Int
  created_at DateTime @default(now())

  media Media @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@unique([media_id, formato, ancho])
  @@map("media_variante")
}

/// Proyectos del portafolio (UC-03).
model Proyecto {
  id               String    @id @default(uuid()) @db.Uuid
  usuario_admin_id String    @db.Uuid
  titulo           String
  descripcion      String    @db.Text
  url_demo         String?
  url_repositorio  String?
  fecha_inicio     DateTime  @db.Date
  fecha_fin        DateTime? @db.Date
  estado           String
  destacado        Boolean   @default(false)
  orden            Int
  /// Fase 7l, UC-36: `manual` o `github` (importado por la sincronización)
  origen                 String    @default("manual")
  /// Fase 7l, UC-36: id numérico de GitHub; estable aunque renombren el repo
  github_repo_id         BigInt?   @unique
  github_nombre_completo String?
  github_lenguaje        String?
  github_estrellas       Int?
  github_actualizado_en  DateTime?
  /// Fase 7l, UC-36: en false se congela un proyecto importado para editarlo a mano
  sincronizar_github     Boolean   @default(true)

  usuario_admin UsuarioAdmin         @relation(fields: [usuario_admin_id], references: [id])
  imagenes      ProyectoImagen[]
  tecnologias   ProyectoTecnologia[]

  @@map("proyecto")
}

/// Galería de imágenes de un proyecto (tabla de unión proyecto <-> media, con orden propio).
model ProyectoImagen {
  proyecto_id String @db.Uuid
  media_id    String @db.Uuid
  orden       Int

  proyecto Proyecto @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  media    Media    @relation(fields: [media_id], references: [id])

  @@id([proyecto_id, media_id])
  @@map("proyecto_imagen")
}

/// Catálogo reutilizable de tecnologías (evita repetir texto libre por proyecto).
model Tecnologia {
  id     String @id @default(uuid()) @db.Uuid
  nombre String @unique

  proyectos    ProyectoTecnologia[]
  /// Fase 7l, UC-19
  experiencias ExperienciaTecnologia[]

  @@map("tecnologia")
}

/// Tecnologías usadas por proyecto (tabla de unión proyecto <-> tecnologia).
model ProyectoTecnologia {
  proyecto_id   String @db.Uuid
  tecnologia_id String @db.Uuid

  proyecto   Proyecto   @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  tecnologia Tecnologia @relation(fields: [tecnologia_id], references: [id])

  @@id([proyecto_id, tecnologia_id])
  @@map("proyecto_tecnologia")
}

/// Certificaciones (UC-04).
model Certificacion {
  id                String    @id @default(uuid()) @db.Uuid
  usuario_admin_id  String    @db.Uuid
  nombre            String
  institucion       String
  fecha_emision     DateTime  @db.Date
  fecha_expiracion  DateTime? @db.Date
  url_verificacion  String
  credencial_id     String?
  logo_media_id     String?   @db.Uuid
  orden             Int

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])
  logo          Media?       @relation("CertificacionLogo", fields: [logo_media_id], references: [id])

  @@map("certificacion")
}

/// Logros y reconocimientos (UC-05).
model Logro {
  id               String   @id @default(uuid()) @db.Uuid
  usuario_admin_id String   @db.Uuid
  titulo           String
  descripcion      String   @db.Text
  fecha            DateTime @db.Date
  categoria        String
  url_referencia   String?
  orden            Int

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])

  @@map("logro")
}

/// Catálogo reutilizable de plataformas de red social (LinkedIn, GitHub, etc.).
model PlataformaRed {
  id            String @id @default(uuid()) @db.Uuid
  nombre        String @unique
  icono_defecto String

  redes_sociales RedSocial[]

  @@map("plataforma_red")
}

/// Enlaces de redes del administrador (UC-06).
model RedSocial {
  id               String @id @default(uuid()) @db.Uuid
  usuario_admin_id String @db.Uuid
  plataforma_id    String @db.Uuid
  url              String
  orden            Int

  usuario_admin UsuarioAdmin  @relation(fields: [usuario_admin_id], references: [id])
  plataforma    PlataformaRed @relation(fields: [plataforma_id], references: [id])

  @@map("red_social")
}

/// Secciones del editor visual de arrastrar y soltar (UC-07). `configuracion` es JSONB
/// a propósito: la forma de un bloque varía según `tipo_seccion` (excepción documentada
/// en plan-portafolio.md sección 4, no rompe 3FN porque no es una lista de valores atómicos
/// repetidos sino la configuración completa y variable de un único bloque).
model Seccion {
  id               String  @id @default(uuid()) @db.Uuid
  usuario_admin_id String  @db.Uuid
  tipo_seccion     String
  titulo_visible   String
  orden            Int
  visible          Boolean @default(true)
  configuracion    Json

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])

  @@map("seccion")
}

/// Temas visuales (UC-08).
///
/// Regla de negocio (plan-portafolio.md sección 4): solo un TEMA por administrador puede
/// tener `activo = true` a la vez. Prisma no soporta índices únicos parciales de forma
/// declarativa (no existe una cláusula WHERE en `@@unique`), así que esa restricción NO
/// queda expresada en este archivo. Se resuelve en la migración generada por
/// `prisma migrate dev --create-only`, editando a mano el SQL para agregar:
//    CREATE UNIQUE INDEX tema_admin_activo_unico ON tema (usuario_admin_id) WHERE activo = true;
/// Ver también la migración correspondiente en prisma/migrations/. Reforzar además en
/// TemaService con una transacción que desactive el tema previo antes de activar el nuevo.
model Tema {
  id                String  @id @default(uuid()) @db.Uuid
  usuario_admin_id  String  @db.Uuid
  nombre            String
  color_primario    String
  color_secundario  String
  color_fondo       String
  color_texto       String
  fuente_principal  String
  modo              String
  activo            Boolean @default(false)

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])

  @@map("tema")
}

/// Skills/tecnologías destacadas del administrador (UC-16). Patrón de
/// "contenido propio del admin" (como LOGRO), no catálogo compartido:
/// distinto de TECNOLOGIA, que sirve para clasificar proyectos, no para
/// el carrusel de skills del hero.
/// Regla de negocio: `nombre` es único por administrador, sin distinguir
/// mayúsculas/minúsculas (no pueden coexistir "Java" y "java") — igual que
/// TEMA.activo y FONDO_SITIO.activo (ver sus comentarios abajo), esto no se
/// puede expresar con `@@unique` declarativo de Prisma (que es sensible a
/// mayúsculas/minúsculas, no serviría para bloquear ese caso), así que se
/// refuerza con un índice único funcional editado a mano en la migración
/// (`CREATE UNIQUE INDEX skill_admin_nombre_unico ON skill
/// (usuario_admin_id, lower(nombre));`) + validación case-insensitive en
/// SkillsService. No confundir con un `@@unique` real: no existe ninguno
/// en este modelo, el índice vive solo en SQL.
model Skill {
  id               String  @id @default(uuid()) @db.Uuid
  usuario_admin_id String  @db.Uuid
  nombre           String
  icono            String
  orden            Int
  visible          Boolean @default(true)

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])

  @@map("skill")
}

/// Fondo de página animado del sitio público (UC-15), independiente del
/// módulo TEMA (que solo maneja color/tipografía, ver plan-portafolio.md
/// sección 4). Regla de negocio: solo un FONDO_SITIO por administrador
/// puede tener `activo = true` a la vez — mismo mecanismo que TEMA (ver su
/// comentario arriba): índice único parcial editado a mano en la migración
/// (`CREATE UNIQUE INDEX fondo_sitio_admin_activo_unico ON fondo_sitio
/// (usuario_admin_id) WHERE activo = true;`) + transacción en
/// FondoSitioService que desactiva el fondo previo antes de activar el nuevo.
model FondoSitio {
  id               String  @id @default(uuid()) @db.Uuid
  usuario_admin_id String  @db.Uuid
  tipo             String
  configuracion    Json
  activo           Boolean @default(false)

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])

  @@map("fondo_sitio")
}

/// Snapshots de publicación (UC-10, UC-11). `snapshot` es JSONB por la misma razón que
/// `SECCION.configuracion`: es una foto completa del sitio (secciones + tema + contenido)
/// para poder revertir sin rediseñar el esquema cada vez.
///
/// `estado` se mantiene como String libre (no enum de Postgres), igual que `Proyecto.estado`:
/// el proyecto no usa enums en ningún modelo, así que se sigue ese mismo patrón por consistencia;
/// los valores válidos ('borrador' | 'publicado') se validan en el DTO del backend, no en la BD.
///
/// Índice (Sprint 4, UC-12): `GET /sitio` resuelve en cada visita pública contra "la fila con
/// estado='publicado' de publicado_en más reciente". Sin índice, esa consulta sería un full scan
/// de la tabla en cada visita del sitio público (a diferencia de las demás FK de usuario_admin_id,
/// que solo se consultan desde el panel admin de bajo tráfico). No agrega columnas ni cambia el
/// diagrama ER, así que no requiere tocar el bloque mermaid (mismo criterio ya usado en `Tema`
/// para su índice único parcial, que tampoco figura en el ER).
model VersionSitio {
  id               String    @id @default(uuid()) @db.Uuid
  usuario_admin_id String    @db.Uuid
  estado           String
  snapshot         Json
  publicado_en     DateTime?

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])

  @@index([usuario_admin_id, estado, publicado_en])
  @@map("version_sitio")
}

/// Badges importados de Credly/Open Badges u otros (Fase 7d, UC-35).
/// Independiente de Certificacion: la insignia es la imagen oficial emitida por un tercero.
model Insignia {
  id               String    @id @default(uuid()) @db.Uuid
  usuario_admin_id String    @db.Uuid
  nombre           String
  emisor           String
  descripcion      String?   @db.Text
  /// credly | open_badges | generico | manual
  proveedor        String
  id_externo       String?
  url_verificacion String?
  url_origen       String?
  imagen_media_id  String    @db.Uuid
  fecha_emision    DateTime? @db.Date
  fecha_expiracion DateTime? @db.Date
  /// Etiquetas planas: array nativo de Postgres, no JSONB.
  habilidades      String[]  @default([])
  orden            Int
  visible          Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])
  imagen        Media        @relation("InsigniaImagen", fields: [imagen_media_id], references: [id], onDelete: Restrict)

  @@index([usuario_admin_id, orden])
  @@map("insignia")
}

/// Fase 7l, UC-19: puesto de la trayectoria profesional; `fecha_fin` nula = puesto actual.
model ExperienciaLaboral {
  id               String    @id @default(uuid()) @db.Uuid
  usuario_admin_id String    @db.Uuid
  empresa          String
  cargo            String
  descripcion      String    @db.Text
  fecha_inicio     DateTime  @db.Date
  fecha_fin        DateTime? @db.Date
  ubicacion        String?
  /// `presencial` | `remoto` | `hibrido`
  modalidad        String
  url_empresa      String?
  logo_media_id    String?   @db.Uuid
  orden            Int
  visible          Boolean   @default(true)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  usuario_admin UsuarioAdmin             @relation(fields: [usuario_admin_id], references: [id])
  logo          Media?                   @relation("ExperienciaLogo", fields: [logo_media_id], references: [id], onDelete: SetNull)
  tecnologias   ExperienciaTecnologia[]

  @@map("experiencia_laboral")
}

/// Fase 7l, UC-19: tecnologías de un puesto (unión experiencia <-> tecnologia, como proyecto_tecnologia).
model ExperienciaTecnologia {
  experiencia_id String @db.Uuid
  tecnologia_id  String @db.Uuid

  experiencia ExperienciaLaboral @relation(fields: [experiencia_id], references: [id], onDelete: Cascade)
  tecnologia  Tecnologia         @relation(fields: [tecnologia_id], references: [id])

  @@id([experiencia_id, tecnologia_id])
  @@map("experiencia_tecnologia")
}

/// Fase 7l, UC-36: configuración de la sincronización de repos públicos de GitHub (1:1 con el admin).
model IntegracionGithub {
  id                       String    @id @default(uuid()) @db.Uuid
  usuario_admin_id         String    @unique @db.Uuid
  usuario_github           String
  activa                   Boolean   @default(false)
  intervalo_horas          Int       @default(6)
  publicar_automaticamente Boolean   @default(false)
  incluir_forks            Boolean   @default(false)
  incluir_archivados       Boolean   @default(false)
  destacar_nuevos          Boolean   @default(false)
  ultima_sincronizacion_en DateTime?
  ultimo_error             String?
  etag                     String?
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  usuario_admin UsuarioAdmin @relation(fields: [usuario_admin_id], references: [id])

  @@map("integracion_github")
}

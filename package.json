{
  "name": "cv-portafolio",
  "private": true,
  "engines": {
    "node": ">=20.19 <23",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "npm run lint --workspace apps/api --"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "npm run lint --workspace apps/web --"
    ]
  }
}

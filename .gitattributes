# Fase 6 — Fundamentos de producción: finales de línea normalizados.
#
# El equipo trabaja en Windows (core.autocrlf=true) pero las imágenes Docker
# y CI corren en Linux: un script de shell o un entrypoint con CRLF rompe el
# arranque del contenedor ("/bin/sh^M: bad interpreter"). Con esta regla el
# repositorio guarda SIEMPRE LF y los scripts salen a disco con LF aunque el
# checkout sea en Windows.

# Todo lo que git detecte como texto se guarda con LF.
* text=auto eol=lf

# Scripts que ejecuta Linux (contenedores, hooks de husky, CI): LF obligatorio
# también en el working tree de Windows.
*.sh       text eol=lf
*.envsh    text eol=lf
*.template text eol=lf
Dockerfile text eol=lf
.husky/*   text eol=lf

# Scripts de Windows: CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios: nunca normalizar ni mostrar diff textual.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.zip   binary
